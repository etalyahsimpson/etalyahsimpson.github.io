{
  "name": "etalyah-simpson-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Etalyah Simpson engineering portfolio: Next.js static export published to GitHub Pages.",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.portfolio.json",
    "test": "node scripts/verify-content.mjs",
    "build:next": "next build",
    "build:static": "bash scripts/build-static.sh",
    "verify:export": "node scripts/verify-export.mjs",
    "serve:static": "node scripts/serve-static.mjs 4173",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test",
    "previews": "node scripts/generate-previews.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
